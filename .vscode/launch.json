{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug agent-sandbox doctor",
            "type": "debugpy",
            "request": "launch",
            "module": "agent_sandbox.cli",
            "args": [
                "doctor",
                "--profile",
                "gigachad"
            ],
            "env": {
                "PYTHONPATH": "${workspaceFolder}/src"
            },
            "envFile": "${workspaceFolder}/.env",
            "justMyCode": false,
            "console": "integratedTerminal"
        }
    ]
}
